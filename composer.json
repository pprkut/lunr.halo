{
    "name": "lunr/halo",
    "description": "Lunr.Halo is a set of PHPUnit helper libraries.",
    "keywords": [
        "phpunit",
        "unit tests",
        "mocking"
    ],
    "homepage": "https://github.com/lunr-php/lunr.halo",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true
    },
    "require": {
        "php": ">=8.3",
        "ext-uopz": ">=7.1.1",
        "phpunit/phpunit": ">=10.5 <11.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "~v1.2",
        "framna-nl/php-library-justfiles": "dev-master",
        "lunr/coding-standard": "0.11.0",
        "phpstan/phpstan": "~2.1.36",
        "psr/log": ">=3.0",
        "psr/container": ">=2.0.2",
        "shipmonk/composer-dependency-analyser": "~1.8",
        "slevomat/coding-standard": "8.15.0",
        "squizlabs/php_codesniffer": "~3.13"
    },
    "scripts": {
        "phpcs": [
            "just phpcs"
        ],
        "phpstan": [
            "just phpstan"
        ],
        "phpunit": [
            "just phpunit"
        ]
    },
    "autoload": {
        "psr-4": {
            "Lunr\\Halo\\": "src/Lunr/Halo/"
        }
    }
}
